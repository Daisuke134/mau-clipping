# mau-clipping — environment variables
# Copy to .env and fill. NEVER commit .env to git.

# === Postiz (self-host or cloud) ===
POSTIZ_API_KEY="..."
POSTIZ_TT_INTEGRATION_ID=""    # TikTok integration ID
POSTIZ_IG_INTEGRATION_ID=""    # Instagram integration ID
POSTIZ_YT_INTEGRATION_ID=""    # YouTube integration ID

# === Platform policy ===
# Comma-separated list of platforms to post to.
# Default (OSS): tiktok,instagram,youtube
# Anicca runtime override: youtube (YT-only, phone-auth accounts only)
POST_PLATFORMS=tiktok,instagram,youtube

# === Slack reporting (optional) ===
SLACK_BOT_TOKEN=""             # optional, for Slack #metrics digest
SLACK_METRICS_CHANNEL=""       # your Slack channel ID, e.g. C0XXXXXX
